APP_NAME="TiendaGrow"
# En producción real SIEMPRE APP_ENV=production y APP_DEBUG=false
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tiendagrow.nennge.me

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CL

LOG_CHANNEL=stack
LOG_LEVEL=error

# Base de datos MySQL 8.0 en contenedor Docker
DB_CONNECTION=mysql
DB_HOST=tiendagrow-db
DB_PORT=3306
DB_DATABASE=tiendagrow_db
DB_USERNAME=tiendagrow_user
DB_PASSWORD=cambia_esta_clave_segura
DB_ROOT_PASSWORD=cambia_esta_clave_root_segura

# Sesiones, colas y cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=database
